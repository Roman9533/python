import re
from collections import Counter, defaultdict
from datetime import datetime

def analyze_server_logs(log_file):
    stats = {
        'total_requests': 0,
        'requests_by_method': {},
        'requests_by_status': {},
        'top_ips': [],
        'errors_4xx_5xx': 0,
        'busiest_hour': '',
        'largest_response': 0,
        'requests_with_ip': defaultdict(list),
        'requests_with_errors': [],
        'path_counter': Counter()
    }
    
    
    log_pattern = re.compile(
        r'$$(.*?)$$\s+(\d+\.\d+\.\d+\.\d+)\s+-\s+(\w+)\s+"([^"]+)"\s+(\d+)\s+(\d+)\s+"([^"]+)"'
    )
    
    hours_counter = Counter()

    with open(log_file, 'r', encoding='utf-8') as f:
        for line in f:
            match = log_pattern.match(line.strip())
            if match:
                time_str, ip, method, path, status_str, size_str, agent = match.groups()
                
                time_obj = datetime.strptime(time_str, '%Y-%m-%d %H:%M:%S')
                status = int(status_str)
                size = int(size_str)
                
                
                stats['total_requests'] += 1
                
                
                stats['requests_by_method'][method] = stats['requests_by_method'].get(method, 0) + 1
                
                
                stats['requests_by_status'][status] = stats['requests_by_status'].get(status, 0) + 1
                
                
                stats['requests_with_ip'][ip].append(line.strip())
                
                
                if 400 <= status < 600:
                    stats['errors_4xx_5xx'] += 1
                    stats['requests_with_errors'].append(line.strip())
                
                
                if size > stats['largest_response']:
                    stats['largest_response'] = size
                
                
                hour_str = time_obj.strftime('%H:00-%H:59')
                hours_counter[hour_str] += 1
                
                
                stats['path_counter'][path] += 1

    
    if hours_counter:
        stats['busiest_hour'] = hours_counter.most_common(1)[0][0]
    
    
    top_ips = Counter(stats['requests_with_ip']).most_common(5)
    stats['top_ips'] = [(ip, count) for ip, count in top_ips]
    
    return stats

def generate_log_report(stats):
    total = stats['total_requests']
    errors = stats['errors_4xx_5xx']
    max_size = stats['largest_response']
    method_counts = stats['requests_by_method']
