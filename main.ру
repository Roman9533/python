def generate_report(sales, start_date, end_date):
    start = datetime.strptime(start_date, "%Y-%m-%d")
    end = datetime.strptime(end_date, "%Y-%m-%d")
    filtered_sales = [s for s in sales if start <= datetime.strptime(s['date'], "%Y-%m-%d") <= end]
