import string

# Словарь для хранения паролей
passwords = {}

# Функция проверки надёжности пароля
def check_password_strength(password):
    # Проверки
    length_ok = len(password) >= 8
    has_digit = any(char.isdigit() for char in password)
    has_upper = any(char.isupper() for char in password)
    special_chars = "!@#$%^&*"
    has_special = any(char in special_chars for char in password)

    # Оценка надёжности
    score = sum([length_ok, has_digit, has_upper, has_special])

    if score == 4:
        return "сильный"
    elif score == 3:
        return "средний"
    else:
        return "слабый"

# Функция добавления пароля
def add_password(site, password):
    strength = check_password_strength(password)
    passwords[site] = password
    print(f"Пароль для '{site}' добавлен. Надёжность: {strength}")

# Показать все пароли
def show_all_passwords():
    if not passwords:
        print("Пароли ещё не добавлены.")
    else:
        print("Сохранённые пароли:")
        for site, pwd in passwords.items():
            print(f"{site}: {pwd}")

# Найти пароль по сайту
def find_password(site):
    if site in passwords:
        print(f"Пароль для '{site}' — {passwords[site]}")
    else:
        print(f"Пароль для '{site}' не найден.")

