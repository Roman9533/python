import random
import time

game_stats = []

def generate_hint(secret, guess):
    diff = abs(secret - guess)
    if diff <= 5:
        closeness = "Горячо!"
    elif diff <= 15:
        closeness = "Тепло"
    else:
        closeness = "Холодно"
    direction = "больше" if guess < secret else "меньше"
    if guess == secret:
        direction = "угадано"
    return f"{closeness} Значение {direction}."

def calculate_score(attempts, elapsed_time):
    score = 100
    score -= attempts * 10  
    if elapsed_time < 10:
        score += 20
    elif elapsed_time < 30:
        score += 10
    return max(score, 0)  

def play_game():
    secret = random.randint(1, 100)
    print("Я загадал число от 1 до 100. Попробуйте угадать!")
    attempts = 0
    start = time.time()

    while True:
        guess = int(input("Введите ваше предположение: "))
        attempts += 1

        hint = generate_hint(secret, guess)
        print(hint)

        if guess == secret:
            elapsed = time.time() - start
            score = calculate_score(attempts, elapsed)
            print(f"Поздравляем! Вы угадали число за {attempts} попыток и {elapsed:.1f} секунд. Очки: {score}")
            game_stats.append({
                "attempts": attempts,
                "time": elapsed,
                "score": score
            })
            break

def show_statistics():
    if not game_stats:
        print("Статистика игр пуста.")
    else:
        print("\nСтатистика прошлых игр:")
        for i, stat in enumerate(game_stats, start=1):
            print(f"Игра {i}: Попытки — {stat['attempts']}, Время — {stat['time']:.1f}s, Очки — {stat['score']}")


class Product:
    def __init__(self, name, price, quantity):
        self.name = name
        self.price = price
        self.quantity = quantity
    
    def __str__(self):
        return f"{self.name} — {self.price}₽ (в наличии: {self.quantity})"

class Customer:
    def __init__(self, name, email, balance):
        self.name = name
        self.email = email
        self.balance = balance
        self.purchase_history = [] 
    
    def __str__(self):
        return f"{self.name} ({self.email}), Баланс: {self.balance}₽"

class Cart:
    def __init__(self, customer):
        self.customer = customer
        self.items = {}  

    def add_product(self, product, amount=1):
        if product.quantity < amount:
            print(f"Недостаточно товара: {product.name}")
            return
        self.items[product] = self.items.get(product, 0) + amount
        print(f"Добавлено {amount} × {product.name} в корзину.")

    def remove_product(self, product, amount=1):
        if product not in self.items:
            print(f"{product.name} нет в корзине.")
            return
        if amount >= self.items[product]:
            self.items.pop(product)
        else:
            self.items[product] -= amount
        print(f"Удалено {amount} × {product.name} из корзины.")

    def total_price(self):
        return sum(product.price * qty for product, qty in self.items.items())

    def checkout(self):
        total = self.total_price()
        print(f"Итог к оплате: {total}₽")
        if self.customer.balance >= total:
            self.customer.balance -= total
            for product, qty in self.items.items():
                product.quantity -= qty
                self.customer.purchase_history.append((product, qty))
            print("Покупка оформлена!")
            self.items.clear()
        else:
            print("Недостаточно средств для оплаты.")


