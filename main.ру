def get_rating_delta(rating_a, rating_b, result, K=32):
    """
    Расчет изменения рейтинга для игрока A.
    :param rating_a: текущий рейтинг игрока A
    :param rating_b: рейтинг противника
    :param result: результат для игрока A (1 — победа, 0.5 — ничья, 0 — проигрыш)
    :param K: коэффициент скорости изменения
    :return: изменение рейтинга (целое число)
    """
    import math

    E = 1 / (1 + 10 ** ((rating_b - rating_a) / 400))
    delta = round(K * (result - E))
    return delta

def register_match(p1_id, p2_id, winner, players):
    """
    Регистрирует матч и обновляет рейтинги игроков.
    :param p1_id: ID первого игрока
    :param p2_id: ID второго игрока
    :param winner: 1 — победил первый, 2 — второй, 0 — ничья
    :param players: словарь с данными игроков
    """
    p1 = players[p1_id]
    p2 = players[p2_id]

    
    if winner == 1:
        result_p1, result_p2 = 1, 0
    elif winner == 2:
        result_p1, result_p2 = 0, 1
    else:
        result_p1, result_p2 = 0.5, 0.5

   
    delta_p1 = get_rating_delta(p1['rating'], p2['rating'], result_p1)
    delta_p2 = get_rating_delta(p2['rating'], p1['rating'], result_p2)

    
    p1['rating'] += delta_p1
    p2['rating'] += delta_p2

    
    p1['matches'] += 1
    p2['matches'] += 1

   
    print(f"Рейтинг игрока {p1['name']} изменился на {delta_p1:+}")
    print(f"Рейтинг игрока {p2['name']} изменился на {delta_p2:+}")

def show_leaderboard(players):
    """
    Выводит таблицу лидеров по убыванию рейтинга.
    :param players: словарь с данными игроков
    """
    sorted_players = sorted(players.items(), key=lambda x: x[1]['rating'], reverse=True)
    print("\n=== Таблица лидеров ===")
    for idx, (player_id, info) in enumerate(sorted_players, 1):
        print(f"{idx}. {info['name']} - {info['rating']} очков ({info['matches']} матчей)")


