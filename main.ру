def total_revenue(sales):
    return sum(item['price'] * item['quantity'] for item in sales)

def best_selling_product(sales):
    product_sales = {}
    for item in sales:
        product = item['product']
        product_sales[product] = product_sales.get(product, 0) + item['quantity']
    return max(product_sales, key=product_sales.get) if product_sales else None

def best_seller(sales):
    seller_revenue = {}
    for item in sales:
        seller = item['seller']
        seller_revenue[seller] = seller_revenue.get(seller, 0) + item['price'] * item['quantity']
    return max(seller_revenue, key=seller_revenue.get) if seller_revenue else None

def sales_by_category(sales):
    category_revenue = {}
    for item in sales:
        category = item['category']
        category_revenue[category] = category_revenue.get(category, 0) + item['price'] * item['quantity']
    return category_revenue

def daily_sales(sales):
    daily_revenue = {}
    for item in sales:
        date = item['date']
        daily_revenue[date] = daily_revenue.get(date, 0) + item['price'] * item['quantity']
    return daily_revenue

def add_sale(sales, new_sale):
    required_keys = {'date', 'product', 'category', 'price', 'quantity', 'seller'}
    if not required_keys.issubset(new_sale.keys()):
        raise ValueError("Недостающие ключи в новой продаже")
    if (not isinstance(new_sale['price'], (int, float)) or new_sale['price'] < 0 or
        not isinstance(new_sale['quantity'], int) or new_sale['quantity'] < 0):
        raise ValueError("Некорректные значения цены или количества")
    sales.append(new_sale)



